  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.19607843, g: 0.19607843, b: 0.19607843, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 32
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 0
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "Scenario: Touching door handles can spread germs and is inconvenient when
    carrying items.\r\nProblem: Build a small door that opens automatically when
    someone approaches, with an LED to show when it\u2019s opening.\r\nComponents:\r\n   
    \u2022 Arduino Uno\r\n    \u2022 Ultrasonic Sensor\r\n    \u2022 Servo Motor\r\n   
    \u2022 LED (any color)\r\n    \u2022 Resistor (220 \u03A9 for LED)\r\n    \u2022
    Jumper Wires, Breadboard\r\nHow It Works:\r\n    \u2022 The ultrasonic sensor
    keeps checking the distance.\r\n    \u2022 If a person is within about 30 cm,
    the LED turns on and the servo rotates to open the door.\r\n    \u2022 After
    a short delay, the servo returns to the closed position and the LED turns off."
