MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1832440620}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.19607843, g: 0.19607843, b: 0.19607843, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 20
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 0
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "<B>Scenario</B>\nTo avoid spreading germs, many places now prefer contactless
    systems like automatic hand sanitizers and touchless doorbells.\r\nProblem Statement:
    Create a touch-free doorbell using a single IR sensor that rings a buzzer when
    someone waves their hand near it.\n\r\n<B>Components:</B>\n    \u2022 Arduino
    Uno\r\n    \u2022 IR Proximity Sensor\r\n    \u2022 Buzzer\r\n    \u2022 LED
    (optional for visual alert)\r\n    \u2022 Jumper Wires, Breadboard\n\r\n<B>How
    It Works:\r</B>\n    \u2022 The IR sensor detects an object (hand) within a short
    distance (e.g., 5\u201310 cm).\r\n    \u2022 When a hand is waved near the sensor,
    the Arduino activates a buzzer and optionally lights up an LED to signal that
    someone is at the door.\r\n    \u2022 The system resets after a few seconds and
    waits for the next hand wave.\r\n"
