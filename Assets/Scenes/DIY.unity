  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.19607843, g: 0.19607843, b: 0.19607843, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 20
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 0
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "<B>Scenario</B>\n Classrooms become hot and fans aren't always turned
    on promptly.\nProblem Statement: Design a system that automatically controls
    a fan based on room temperature.\n\n<B>Components:\r</B>\n    \u2022 Arduino
    Uno\r\n    \u2022 DHT11 Temperature & Humidity Sensor\r\n    \u2022 DC Motor
    to run a Fan\r\n    \u2022 Jumper Wires\r\n\n<B>How It Works:</B>\nThe DHT11
    sensor continuously monitors the temperature. If it crosses a preset threshold
    (e.g., 30\xB0C), the Arduino turns on the fan. When it drops below the threshold,
    the fan is turned off."
