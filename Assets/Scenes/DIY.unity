    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 0
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "<B>Scenario</B>\nLights are often left on in empty rooms, wasting electricity.\nProblem
    Statement: Create a system that turns the lights on when motion is detected and
    off when no one is present.\n\n<B>Components:\r</B>\n    \u2022 Arduino Uno\r\n   
    \u2022 PIR Motion Sensor\r\n    \u2022 LED/Bulb\r\n    \u2022 Jumper Wires, Breadboard\n\r\n<B>How
    It Works:</B>\nThe PIR sensor detects motion in the room. When movement is detected,
    the Arduino turns on the light. After a few seconds of no motion, it automatically
    turns the light off."
